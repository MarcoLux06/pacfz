#!/usr/bin/env python3
"""Prototype Textual TUI front-end for pacfz — the package overview view.

This is a third front-end alongside `pacfz` (fzf-interactive) and `pacq`
(non-interactive), not a replacement for either. It reuses the exact same
data layer (list_packages.py, notes_db.py, preview_item.py) by importing
them directly rather than shelling out — no subprocess, no text parsing.

Prototype scope: just the package overview screen (search + facet filters
+ table + preview). Multiple screens (dependency tree, history) come later.
"""
import os
import sys

# Resolve the sibling lib/ directory the same way the bash launchers do:
# next to this script in a dev checkout, or /usr/share/pacfz/lib once
# installed via the PKGBUILD.
_SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
_LIB_DIR = os.path.join(_SCRIPT_DIR, 'lib')
if not os.path.isfile(os.path.join(_LIB_DIR, 'list_packages.py')):
    _LIB_DIR = '/usr/share/pacfz/lib'
sys.path.insert(0, _LIB_DIR)

from typing import Optional

from rich.text import Text
from textual.app import App, ComposeResult
from textual.containers import Horizontal, Vertical, VerticalScroll
from textual.theme import Theme
from textual.widgets import (
    Checkbox, DataTable, Footer, Header, Input, RadioButton, RadioSet, Select,
    Static,
)

import list_packages as lp
import notes_db
import preview_item

# One Dark (Atom's default dark theme) — canonical palette, not an
# approximation: background/foreground/accents match the original
# atom/one-dark-syntax values used across onedark.vim and One Dark Pro.
ONE_DARK = Theme(
    name="one-dark",
    dark=True,
    background="#282c34",
    surface="#2c313a",
    panel="#21252b",
    primary="#61afef",  # blue
    secondary="#56b6c2",  # cyan
    accent="#c678dd",  # purple
    warning="#e5c07b",  # yellow
    error="#e06c75",  # red
    success="#98c379",  # green
    foreground="#abb2bf",
)

SELECT_COLS = '"Name", "Version", "Installed_Size", "Install_Reason"'

# (column header, width) — Installed_Size is rendered human-readable, not raw.
COLUMNS = [
    ("Name", 28),
    ("Version", 16),
    ("Size", 10),
    ("Reason", 22),
]


class VimDataTable(DataTable):
    """DataTable with vim motions (j/k/g/G) layered on top of the arrow keys.

    Reuses the widget's own cursor_up/cursor_down/scroll_top/scroll_bottom
    actions rather than reimplementing movement — j/k/g/G are just
    additional key bindings pointing at the same actions the arrow
    keys/Home/End already trigger.
    """

    BINDINGS = [
        ("j", "cursor_down", "Down"),
        ("k", "cursor_up", "Up"),
        ("g", "scroll_top", "Top"),
        ("G", "scroll_bottom", "Bottom"),
    ]


def _fuzzy_match(needle: str, haystack: str) -> bool:
    """True if every character of `needle` appears in `haystack`, in order,
    possibly with gaps — the same subsequence test fzf's default (non
    --exact) matching is built on. Case-insensitive, matching fzf's default.
    """
    needle = needle.lower()
    haystack = haystack.lower()
    pos = 0
    for ch in needle:
        pos = haystack.find(ch, pos)
        if pos == -1:
            return False
        pos += 1
    return True


def _short_reason(reason: str) -> str:
    """Compact the verbose Install_Reason string for the table column."""
    if reason == "Explicitly installed":
        return "explicit"
    if reason == "Installed as a dependency for another package":
        return "dependency"
    return reason or ""


class PackageOverview(App):
    """The package-overview screen.

    Layout: split top/bottom first. The top region is split left/right (40%
    search+table, 60% preview) — same as before. The bottom region is the
    filter panel, now spanning the full width to fit every filter dimension
    the CLI supports (except -t/-v/-s/--asc/--desc, deferred for now).
    """

    CSS = """
    Screen {
        layout: vertical;
    }

    #top-region {
        layout: horizontal;
        height: 1fr;
    }

    #left-pane {
        width: 40%;
        height: 100%;
    }

    #package-table {
        height: 1fr;
    }

    #preview-pane {
        width: 60%;
        height: 100%;
        border-left: solid $accent;
        padding: 0 1;
    }

    #preview-scroll {
        height: 1fr;
    }

    #preview-content {
        height: auto;
    }

    #filter-area {
        height: auto;
        max-height: 16;
        width: 100%;
        border-top: solid $accent;
        padding: 0 1;
    }

    #filter-row {
        height: auto;
        layout: horizontal;
    }

    #filter-row > Vertical {
        width: auto;
        margin-right: 3;
    }

    /* RadioSet defaults to width: 1fr internally, which would otherwise
       force its parent Vertical (and everything after it in the row) to
       expand and get crowded off-screen. Override it explicitly. */
    /* RadioSet's `width: auto` does not reliably constrain its rendered
       size (it reports the correct small content width via
       get_content_width, but still renders expanded to fill available
       space) — give it an explicit fixed width instead, wide enough for
       the longest label ("Dependency") plus the radio marker. */
    RadioSet {
        width: 20;
    }

    #checkbox-group {
        layout: grid;
        grid-size: 2;
        grid-gutter: 0 2;
        width: auto;
    }

    .facet-label {
        color: $accent;
        text-style: bold;
    }

    #field-select {
        width: 24;
    }

    #field-value {
        width: 24;
    }
    """

    BINDINGS = [
        ("/", "focus_search", "Search"),
        ("q", "quit", "Quit"),
    ]

    def __init__(self) -> None:
        super().__init__()
        self._current_name: Optional[str] = None

    def compose(self) -> ComposeResult:
        yield Header(show_clock=False)

        with Horizontal(id="top-region"):
            with Vertical(id="left-pane"):
                yield Input(placeholder="Search by name...", id="search-input")
                yield VimDataTable(id="package-table", cursor_type="row")

            with Vertical(id="preview-pane"):
                with VerticalScroll(id="preview-scroll"):
                    yield Static(id="preview-content")

        with Vertical(id="filter-area"):
            with Horizontal(id="filter-row"):
                with Vertical():
                    yield Static("Type", classes="facet-label")
                    with RadioSet(id="reason-filter"):
                        yield RadioButton("Any", value=True)
                        yield RadioButton("Explicit")
                        yield RadioButton("Dependency")
                with Vertical():
                    yield Static("Notes", classes="facet-label")
                    with RadioSet(id="notes-filter"):
                        yield RadioButton("Any", value=True)
                        yield RadioButton("Has note")
                        yield RadioButton("No note")
                with Vertical(id="checkbox-group"):
                    yield Checkbox("Foreign", id="cb-foreign")
                    yield Checkbox("Orphan", id="cb-orphan")
                    yield Checkbox("Not a dep", id="cb-notadep")
                    yield Checkbox("Not opt-dep", id="cb-notoptdep")
                with Vertical():
                    yield Static("Search", classes="facet-label")
                    yield Checkbox("All fields (not just name)", id="cb-all-fields")
                    with RadioSet(id="search-mode"):
                        yield RadioButton("Substring", value=True)
                        yield RadioButton("Exact")
                        yield RadioButton("Fuzzy (fzf-style)")
                with Vertical():
                    yield Static("Field filter", classes="facet-label")
                    yield Select([], id="field-select", prompt="(field)")
                    yield Input(placeholder="value...", id="field-value")
                    yield Checkbox("Exact match", id="cb-exact")

        yield Footer()

    def on_mount(self) -> None:
        self.register_theme(ONE_DARK)
        self.theme = "one-dark"

        lp.ensure_cache_db()

        table = self.query_one("#package-table", DataTable)
        for header, width in COLUMNS:
            table.add_column(header, width=width, key=header)

        # Field-search dropdown options come from the real schema, so
        # whatever's selected always resolves cleanly in build_query().
        columns = lp.get_table_columns()
        field_select = self.query_one("#field-select", Select)
        field_select.set_options(
            (col.replace("_", " "), col.replace("_", " ")) for col in columns
        )

        self.refresh_results()
        self.query_one("#search-input", Input).focus()

    # ------------------------------------------------------------------
    # Filter state -> query
    # ------------------------------------------------------------------
    def _search_mode(self) -> str:
        label = self._radio_label("#search-mode")
        if label == "Exact":
            return "exact"
        if label and label.startswith("Fuzzy"):
            return "fuzzy"
        return "substring"

    def _build_query_kwargs(self) -> dict:
        where_clauses = []
        if self.query_one("#cb-foreign", Checkbox).value:
            where_clauses.append("foreign")
        if self.query_one("#cb-orphan", Checkbox).value:
            where_clauses.append("orphan")
        if self.query_one("#cb-notadep", Checkbox).value:
            where_clauses.append("notadep")
        if self.query_one("#cb-notoptdep", Checkbox).value:
            where_clauses.append("notoptdep")

        reason = self._radio_label("#reason-filter")
        if reason == "Explicit":
            where_clauses.append("explicit")
        elif reason == "Dependency":
            where_clauses.append("deps")

        field_exact_match = self.query_one("#cb-exact", Checkbox).value

        field_searches = []
        any_field_searches = None

        # Fuzzy mode can't be expressed as SQL (LIKE/= don't do subsequence
        # matching) — its search term is deliberately left OUT of the query
        # here and applied as a post-filter in refresh_results() instead.
        search_mode = self._search_mode()
        search_text = self.query_one("#search-input", Input).value.strip()
        if search_text and search_mode != "fuzzy":
            if self.query_one("#cb-all-fields", Checkbox).value:
                any_field_searches = [search_text]
            else:
                field_searches.append(("Name", search_text))

        field = self.query_one("#field-select", Select).value
        value = self.query_one("#field-value", Input).value.strip()
        if field is not Select.NULL and value:
            field_searches.append((str(field), value))

        # NOTE: exact_match is a single flag shared by build_query() across
        # every field_searches/any_field_searches entry — so the search bar
        # (substring/exact radio) and the Field filter's own Exact-match
        # checkbox can't be set independently when BOTH are active at once.
        # In practice this only matters if you use the search bar AND the
        # field filter simultaneously with conflicting modes; the field
        # filter's checkbox wins in that combination since it's OR'd in.
        exact_match = field_exact_match or (search_mode == "exact")

        return dict(
            where_clauses=where_clauses or None,
            any_field_searches=any_field_searches,
            field_searches=field_searches or None,
            exact_match=exact_match,
            select_cols=SELECT_COLS,
        )

    def _radio_label(self, selector: str) -> Optional[str]:
        radio_set = self.query_one(selector, RadioSet)
        if radio_set.pressed_button is None:
            return None
        return str(radio_set.pressed_button.label)

    def _notes_filter(self) -> Optional[str]:
        label = self._radio_label("#notes-filter")
        if label == "Has note":
            return "has_note"
        if label == "No note":
            return "no_note"
        return None

    # ------------------------------------------------------------------
    # Query execution
    # ------------------------------------------------------------------
    def refresh_results(self) -> None:
        table = self.query_one("#package-table", DataTable)
        table.clear()

        try:
            query, params = lp.build_query(**self._build_query_kwargs())
        except ValueError:
            return

        notes_filter = self._notes_filter()
        rows = list(lp.iter_rows(query, params, notes_filter))

        search_mode = self._search_mode()
        search_text = self.query_one("#search-input", Input).value.strip()
        if search_text and search_mode == "fuzzy":
            all_fields = self.query_one("#cb-all-fields", Checkbox).value
            if all_fields:
                rows = [
                    r for r in rows
                    if any(_fuzzy_match(search_text, str(v)) for v in r if v is not None)
                ]
            else:
                rows = [r for r in rows if _fuzzy_match(search_text, r[0])]

        for name, version, size, reason in rows:
            table.add_row(
                name, version or "", preview_item.bytes_to_human(size),
                _short_reason(reason), key=name,
            )

        if rows and table.row_count:
            table.move_cursor(row=0)
            self._show_preview(rows[0][0])
        else:
            self._current_name = None
            self.query_one("#preview-content", Static).update("")

    # ------------------------------------------------------------------
    # Preview
    # ------------------------------------------------------------------
    def _show_preview(self, name: str) -> None:
        self._current_name = name
        data = preview_item.query_database(name=name)
        if not data:
            self.query_one("#preview-content", Static).update("")
            return
        note = notes_db.get_note(name)
        if note:
            data["Note"] = note
        rendered = preview_item.render_preview(data)
        self.query_one("#preview-content", Static).update(Text.from_ansi(rendered))

    # ------------------------------------------------------------------
    # Events
    # ------------------------------------------------------------------
    def on_input_changed(self, event: Input.Changed) -> None:
        if event.input.id in ("search-input", "field-value"):
            self.refresh_results()

    def on_input_submitted(self, event: Input.Submitted) -> None:
        if event.input.id == "search-input":
            table = self.query_one("#package-table", DataTable)
            if table.row_count:
                table.focus()

    def on_select_changed(self, event: Select.Changed) -> None:
        self.refresh_results()

    def on_checkbox_changed(self, event: Checkbox.Changed) -> None:
        self.refresh_results()

    def on_radio_set_changed(self, event: RadioSet.Changed) -> None:
        self.refresh_results()

    def on_data_table_row_highlighted(self, event: DataTable.RowHighlighted) -> None:
        if event.row_key.value is not None:
            self._show_preview(event.row_key.value)

    def action_focus_search(self) -> None:
        self.query_one("#search-input", Input).focus()


if __name__ == "__main__":
    PackageOverview().run()
