#!/usr/bin/env python3
"""pactui — Textual TUI front-end for pacfz, a focused search + preview view.

This is a third front-end alongside `pacfz` (fzf-interactive) and `pacq`
(non-interactive), not a replacement for either. It reuses the exact same
data layer (list_packages.py, notes_db.py, preview_item.py) by importing
them directly rather than shelling out — no subprocess, no text parsing.

Deliberately single-purpose: search, filter, and preview installed
packages, nothing else. No package-stats overview, no pacman.log viewer —
other tools already do that well.
"""
import os
import sys
import time

# Resolve the sibling lib/ directory the same way the bash launchers do:
# next to this script in a dev checkout, or /usr/share/pacfz/lib once
# installed via the PKGBUILD.
_SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
_LIB_DIR = os.path.join(_SCRIPT_DIR, 'lib')
if not os.path.isfile(os.path.join(_LIB_DIR, 'list_packages.py')):
    _LIB_DIR = '/usr/share/pacfz/lib'
sys.path.insert(0, _LIB_DIR)

from dataclasses import dataclass
from typing import Optional

try:
    from rich.text import Text
    from textual import work
    from textual.app import App, ComposeResult
    from textual.containers import Horizontal, HorizontalScroll, Vertical, VerticalScroll
    from textual.message import Message
    from textual.screen import Screen
    from textual.widgets import (
        Checkbox, DataTable, Footer, Header, Input, Label, RadioButton, RadioSet,
        Select, Static,
    )
except ImportError:
    print("Error: python-textual is not installed, but is required for pactui.",
          file=sys.stderr)
    print("Install it with: sudo pacman -S python-textual", file=sys.stderr)
    print("(pacfz and pacq work without it, if you just need the fzf/CLI front-ends.)",
          file=sys.stderr)
    sys.exit(1)

import list_packages as lp
import notes_db
import preview_item

SELECT_COLS = '"Name", "Version", "Installed_Size", "Install_Reason"'

# (column header, width) — Installed_Size is rendered human-readable, not raw.
COLUMNS = [
    ("Name", 28),
    ("Version", 16),
    ("Size", 10),
    ("Reason", 22),
]


class VimDataTable(DataTable):
    """DataTable with vim motions (j/k/g/G) layered on top of the arrow keys.

    Reuses the widget's own cursor_up/cursor_down/scroll_top/scroll_bottom
    actions rather than reimplementing movement — j/k/g/G are just
    additional key bindings pointing at the same actions the arrow
    keys/Home/End already trigger.
    """

    BINDINGS = [
        ("j", "cursor_down", "Down"),
        ("k", "cursor_up", "Up"),
        ("g", "scroll_top", "Top"),
        ("G", "scroll_bottom", "Bottom"),
    ]


def _short_reason(reason: str) -> str:
    """Compact the verbose Install_Reason string for the table column."""
    if reason == "Explicitly installed":
        return "explicit"
    if reason == "Installed as a dependency for another package":
        return "dependency"
    return reason or ""


# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Shared: filter state + query translation ("unified backend" for filtering)
# ---------------------------------------------------------------------------
# FilterState is a plain data container — no widget references, no I/O. Each
# screen that shows a filter panel owns and creates its own independent
# instance; nothing here is global or shared across screens. Two screens
# each showing a FilterPanel will each have their own separate FilterState,
# and changing one never affects the other.
#
# filter_state_to_query_kwargs() is the one place the *meaning* of a filter
# combination is translated into build_query() kwargs — reusable by anything
# that needs "the currently selected filters" as a query, e.g. a future
# per-filter storage-size calculator, not just this screen's own table.
#
# Every relationship filter (foreign, orphan, dependency, required-by-
# something, optional-dep-for-something) is three-state: Any / Yes / No.
# This subsumes the CLI's -v/--invert entirely within the TUI — "No" for a
# filter IS the inverted case, expressed directly rather than as a separate
# invert step. Any = don't care (omit the clause), Yes = require it, No =
# require its negation.
TRISTATE_CHOICES = ("Any", "Yes", "No")
NOTES_CHOICES = ("Any", "Has note", "No note")
SEARCH_MODE_CHOICES = ("Substring", "Exact")

# (state field name, WHERE_CLAUSES key) for every tri-state relationship
# filter. "Yes"/"No" become preconditions or scoped inverts via
# build_query()'s invert_clauses, so each filter's negation is independent
# of every other filter — unlike bare -v, which inverts everything at once.
TRISTATE_FILTERS = [
    ("foreign", "foreign"),
    ("orphan", "orphan"),
    ("dependency", "deps"),
    ("required_by_something", "notadep"),  # "Yes" == NOT(notadep)
    ("optdep_for_something", "notoptdep"),  # "Yes" == NOT(notoptdep)
]


@dataclass
class FilterState:
    foreign: str = "Any"  # one of TRISTATE_CHOICES
    orphan: str = "Any"
    dependency: str = "Any"
    required_by_something: str = "Any"
    optdep_for_something: str = "Any"
    notes: str = "Any"  # one of NOTES_CHOICES
    search_text: str = ""
    search_field: str = "Name"  # real column name, e.g. "Licenses"
    search_mode: str = "Substring"  # one of SEARCH_MODE_CHOICES


def filter_state_to_query_kwargs(state: FilterState):
    """Translate a FilterState into (build_query kwargs, notes_filter).

    Pure -- no widget access, no I/O. This is the single place that knows
    what each filter *means* in query terms, so every consumer (this
    screen's table, a future size calculator, anything else) computes
    identical results for the same FilterState.
    """
    where_clauses = []
    invert_each = []

    for state_attr, clause_key in TRISTATE_FILTERS:
        choice = getattr(state, state_attr)
        is_inverted_concept = state_attr in (
            "required_by_something", "optdep_for_something"
        )
        if choice == "Yes":
            # required_by_something/optdep_for_something are themselves the
            # NEGATION of their underlying clause (notadep/notoptdep mean
            # "not required by anything") -- so "Yes, it IS required by
            # something" is NOT(notadep). Both cases end up in invert_each.
            (invert_each if is_inverted_concept else where_clauses).append(clause_key)
        elif choice == "No":
            (where_clauses if is_inverted_concept else invert_each).append(clause_key)
        # "Any" -> omit entirely, neither list

    field_searches = []
    search_text = state.search_text.strip()
    if search_text:
        field_searches.append((state.search_field, search_text))

    notes_filter = None
    if state.notes == "Has note":
        notes_filter = "has_note"
    elif state.notes == "No note":
        notes_filter = "no_note"

    query_kwargs = dict(
        where_clauses=where_clauses or None,
        invert_each=invert_each or None,
        field_searches=field_searches or None,
        exact_match=(state.search_mode == "Exact"),
        select_cols=SELECT_COLS,
    )
    return query_kwargs, notes_filter


class FilterPanel(Vertical):
    """Self-contained filter facet panel: owns one independent FilterState.

    Each FilterPanel instance has its own state — nothing here is shared
    across screens or instances. A screen embeds a FilterPanel, listens for
    FilterPanel.Changed, and reads `panel.state` (a FilterState) whenever it
    wants to know the current filters — including for reuse in *other*
    features later (e.g. a size calculator), by using filter_state_to_query_
    kwargs() on that same FilterState.

    `orientation` is fixed at construction time ("horizontal" or "vertical")
    — a static per-call-site choice, not a runtime-toggleable setting.

    The main free-text search box is deliberately NOT part of this panel —
    it lives in the containing screen (the "main search bar"), and the
    screen forwards its value in via set_search_text(). The panel only owns
    the *field* (which column to search) and *mode* (substring/exact)
    dropdown/radio that govern how that text is interpreted.
    """

    class Changed(Message):
        """Posted whenever any facet in the panel changes."""

        def __init__(self, panel: "FilterPanel") -> None:
            self.panel = panel
            super().__init__()

    DEFAULT_CSS = """
    FilterPanel {
        height: auto;
        max-height: 16;
        width: 100%;
        border-top: solid $accent;
        padding: 0 1;
    }

    FilterPanel.horizontal > #facet-row {
        layout: horizontal;
        height: auto;
        width: 100%;
    }

    /* Tight spacing between groups, with a left border as the visual
       separator instead of wide margins — keeps the panel compact while
       each group is still clearly delineated. */
    FilterPanel.horizontal > #facet-row > .tristate-group {
        width: auto;
        height: auto;
        padding: 0 1;
        border-left: solid $panel-lighten-2;
    }
    FilterPanel.horizontal > #facet-row > .tristate-group:first-of-type {
        border-left: none;
        padding-left: 0;
    }

    FilterPanel.vertical > #facet-row {
        layout: vertical;
        height: auto;
    }

    FilterPanel.vertical > #facet-row > .tristate-group {
        width: 100%;
        height: auto;
        padding: 0 0 0 1;
        border-left: solid $panel-lighten-2;
        margin-bottom: 1;
    }

    /* RadioSet's `width: auto` does not reliably constrain its rendered
       size — give it an explicit fixed width instead, wide enough for the
       longest label plus the radio marker. */
    FilterPanel RadioSet {
        width: 13;
        height: auto;
    }

    FilterPanel .facet-label {
        width: auto;
        color: $accent;
        text-style: bold;
    }

    FilterPanel Select {
        width: 26;
    }
    """

    def __init__(self, orientation: str = "horizontal", id: Optional[str] = None) -> None:
        assert orientation in ("horizontal", "vertical")
        super().__init__(id=id)
        self._orientation = orientation
        self.add_class(orientation)
        self.state = FilterState()

    def compose(self) -> ComposeResult:
        # HorizontalScroll/VerticalScroll auto-show a scrollbar only when
        # content actually overflows, re-measured on every resize — this is
        # what makes "scroll sideways if the screen is too narrow" work
        # dynamically as the terminal is resized, with no manual scroll-
        # position tracking needed.
        row_container = HorizontalScroll if self._orientation == "horizontal" else VerticalScroll
        with row_container(id="facet-row"):
            with Vertical(classes="tristate-group"):
                yield Static("Foreign", classes="facet-label")
                with RadioSet(id="foreign-filter", compact=True):
                    for choice in TRISTATE_CHOICES:
                        yield RadioButton(choice, value=(choice == "Any"))
            with Vertical(classes="tristate-group"):
                yield Static("Orphan", classes="facet-label")
                with RadioSet(id="orphan-filter", compact=True):
                    for choice in TRISTATE_CHOICES:
                        yield RadioButton(choice, value=(choice == "Any"))
            with Vertical(classes="tristate-group"):
                yield Static("Dependency", classes="facet-label")
                with RadioSet(id="dependency-filter", compact=True):
                    for choice in TRISTATE_CHOICES:
                        yield RadioButton(choice, value=(choice == "Any"))
            with Vertical(classes="tristate-group"):
                yield Static("Required by", classes="facet-label")
                with RadioSet(id="required-by-filter", compact=True):
                    for choice in TRISTATE_CHOICES:
                        yield RadioButton(choice, value=(choice == "Any"))
            with Vertical(classes="tristate-group"):
                yield Static("Optional for", classes="facet-label")
                with RadioSet(id="optdep-for-filter", compact=True):
                    for choice in TRISTATE_CHOICES:
                        yield RadioButton(choice, value=(choice == "Any"))
            with Vertical(classes="tristate-group"):
                yield Static("Notes", classes="facet-label")
                with RadioSet(id="notes-filter", compact=True):
                    for choice in NOTES_CHOICES:
                        yield RadioButton(choice, value=(choice == "Any"))
            with Vertical(classes="tristate-group search-field-group"):
                yield Static("Search field", classes="facet-label")
                yield Select([], id="field-select")
                with RadioSet(id="search-mode", compact=True):
                    for choice in SEARCH_MODE_CHOICES:
                        yield RadioButton(choice, value=(choice == "Substring"))

    def on_mount(self) -> None:
        columns = lp.get_table_columns()
        field_select = self.query_one("#field-select", Select)
        field_select.set_options((col, col) for col in columns)
        field_select.value = "Name"

    def set_search_text(self, text: str) -> None:
        """Called by the containing screen to forward its main search box's value."""
        self.state.search_text = text

    def _radio_label(self, selector: str) -> Optional[str]:
        radio_set = self.query_one(selector, RadioSet)
        if radio_set.pressed_button is None:
            return None
        return str(radio_set.pressed_button.label)

    def _sync_state_from_widgets(self) -> None:
        self.state.foreign = self._radio_label("#foreign-filter") or "Any"
        self.state.orphan = self._radio_label("#orphan-filter") or "Any"
        self.state.dependency = self._radio_label("#dependency-filter") or "Any"
        self.state.required_by_something = self._radio_label("#required-by-filter") or "Any"
        self.state.optdep_for_something = self._radio_label("#optdep-for-filter") or "Any"
        self.state.notes = self._radio_label("#notes-filter") or "Any"
        self.state.search_mode = self._radio_label("#search-mode") or "Substring"
        field = self.query_one("#field-select", Select).value
        if field is not Select.NULL:
            self.state.search_field = str(field)

    def on_radio_set_changed(self, event: RadioSet.Changed) -> None:
        self._sync_state_from_widgets()
        self.post_message(self.Changed(self))

    def on_select_changed(self, event: Select.Changed) -> None:
        self._sync_state_from_widgets()
        self.post_message(self.Changed(self))


class PackageSearchScreen(Screen):
    """Screen 2: search + facet filters + table + preview.

    Layout: split top/bottom first. The top region is split left/right (40%
    search+table, 60% preview). The bottom region is a FilterPanel, laid out
    horizontally and sized to its content (not a fixed max-height) so it's
    only ever as tall as the filters actually need.
    """

    CSS = """
    Screen {
        layout: vertical;
    }

    #top-region {
        layout: horizontal;
        height: 1fr;
    }

    #left-pane {
        width: 40%;
        height: 100%;
    }

    #package-table {
        height: 1fr;
    }

    #preview-pane {
        width: 60%;
        height: 100%;
        border-left: solid $accent;
        padding: 0 1;
    }

    #preview-scroll {
        height: 1fr;
    }

    #preview-content {
        height: auto;
    }

    #search-filter-panel {
        height: auto;
    }
    """

    BINDINGS = [
        ("/", "focus_search", "Search"),
        ("ctrl+r", "refresh_cache", "Refresh cache"),
    ]

    def __init__(self) -> None:
        super().__init__()
        self._current_name: Optional[str] = None

    def compose(self) -> ComposeResult:
        yield Header(show_clock=False)

        with Horizontal(id="top-region"):
            with Vertical(id="left-pane"):
                yield Input(placeholder="Search by name...", id="search-input")
                yield VimDataTable(id="package-table", cursor_type="row")

            with Vertical(id="preview-pane"):
                with VerticalScroll(id="preview-scroll"):
                    yield Static(id="preview-content")

        yield FilterPanel(orientation="horizontal", id="search-filter-panel")

        yield Footer()

    def on_mount(self) -> None:
        lp.ensure_cache_db()

        table = self.query_one("#package-table", DataTable)
        for header, width in COLUMNS:
            table.add_column(header, width=width, key=header)

        self.refresh_results()
        self.query_one("#search-input", Input).focus()

    # ------------------------------------------------------------------
    # Query execution
    # ------------------------------------------------------------------
    def refresh_results(self) -> None:
        table = self.query_one("#package-table", DataTable)
        table.clear()

        panel = self.query_one("#search-filter-panel", FilterPanel)
        panel.set_search_text(self.query_one("#search-input", Input).value)
        query_kwargs, notes_filter = filter_state_to_query_kwargs(panel.state)

        try:
            query, params = lp.build_query(**query_kwargs)
        except ValueError:
            return

        rows = list(lp.iter_rows(query, params, notes_filter))

        for name, version, size, reason in rows:
            table.add_row(
                name, version or "", preview_item.bytes_to_human(size),
                _short_reason(reason), key=name,
            )

        if rows and table.row_count:
            table.move_cursor(row=0)
            self._show_preview(rows[0][0])
        else:
            self._current_name = None
            self.query_one("#preview-content", Static).update("")

    # ------------------------------------------------------------------
    # Preview
    # ------------------------------------------------------------------
    def _show_preview(self, name: str) -> None:
        self._current_name = name
        data = preview_item.query_database(name=name)
        if not data:
            self.query_one("#preview-content", Static).update("")
            return
        note = notes_db.get_note(name)
        if note:
            data["Note"] = note
        rendered = preview_item.render_preview(data)
        self.query_one("#preview-content", Static).update(Text.from_ansi(rendered))

    # ------------------------------------------------------------------
    # Events
    # ------------------------------------------------------------------
    def on_input_changed(self, event: Input.Changed) -> None:
        if event.input.id == "search-input":
            self.refresh_results()

    def on_input_submitted(self, event: Input.Submitted) -> None:
        if event.input.id == "search-input":
            table = self.query_one("#package-table", DataTable)
            if table.row_count:
                table.focus()

    def on_filter_panel_changed(self, event: "FilterPanel.Changed") -> None:
        self.refresh_results()

    def on_data_table_row_highlighted(self, event: DataTable.RowHighlighted) -> None:
        if event.row_key.value is not None:
            self._show_preview(event.row_key.value)

    def action_focus_search(self) -> None:
        self.query_one("#search-input", Input).focus()

    def action_refresh_cache(self) -> None:
        self.app.notify("Refreshing package cache...", timeout=2)
        self._rebuild_cache()

    @work(thread=True, exclusive=True)
    def _rebuild_cache(self) -> None:
        # build_cache_db() shells out to create_db.py via subprocess.run(),
        # which blocks — run it in a real thread (thread=True), not just an
        # async task, so the UI stays responsive while pacman -Qi runs.
        error = None
        try:
            lp.build_cache_db()
        except Exception as e:
            error = str(e)
        self.app.call_from_thread(self._on_cache_refreshed, error)

    def _on_cache_refreshed(self, error: Optional[str]) -> None:
        if error:
            self.app.notify(f"Cache refresh failed: {error}", severity="error", timeout=6)
            return
        self.app.notify(f"\u2713 cache refreshed at {time.strftime('%H:%M:%S')}", timeout=3)
        self.refresh_results()


# ---------------------------------------------------------------------------
# App: owns the single search/preview screen
# ---------------------------------------------------------------------------
class PacTUIApp(App):
    """Top-level app. Single-purpose: search, filter, and preview installed
    packages. No package-stats overview, no pacman.log viewer — other
    tools already do that well.
    """

    TITLE = "pactui"

    BINDINGS = [
        ("q", "quit", "Quit"),
    ]

    def on_mount(self) -> None:
        self.theme = "atom-one-dark"

        # Build the cache before the screen mounts. Without this,
        # PackageSearchScreen's FilterPanel (which queries the schema in
        # its own on_mount) can race a first-run machine that has no cache
        # DB yet, surfacing as an unhandled sqlite "unable to open database
        # file" the moment the screen is installed.
        lp.ensure_cache_db()

        self.install_screen(PackageSearchScreen(), name="search")
        self.push_screen("search")


if __name__ == "__main__":
    if "--version" in sys.argv[1:]:
        import config

        print(f"pacfz {config.__version__}")
        sys.exit(0)
    PacTUIApp().run()
