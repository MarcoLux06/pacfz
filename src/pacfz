#!/usr/bin/env bash

# Find the Python modules either next to this script (running straight from a
# git checkout, no install needed) or under /usr/share/pacfz (where the
# PKGBUILD puts them once installed via `makepkg -si`).
# Find the Python modules either in lib/ next to this script (running
# straight from a git checkout, no install needed) or under
# /usr/share/pacfz/lib (where the PKGBUILD puts them once installed via
# `makepkg -si`). Both layouts mirror each other exactly (src/lib <->
# /usr/share/pacfz/lib), so the only thing that ever changes here is the
# base path.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$SCRIPT_DIR/lib/list_packages.py" ]]; then
  PACFZ_LIBDIR="$SCRIPT_DIR/lib"
else
  PACFZ_LIBDIR="/usr/share/pacfz/lib"
fi
SCRIPT_LIST="$PACFZ_LIBDIR/list_packages.py"
SCRIPT_PREVIEW="$PACFZ_LIBDIR/preview_item.py"
SCRIPT_CREATE_DB="$PACFZ_LIBDIR/create_db.py"
SCRIPT_NOTES="$PACFZ_LIBDIR/note_manager.py"

show_usage() {
  echo "Usage: pacfz [OPTIONS]"
  echo ""
  echo "Filter Options:"
  echo "  -m, --foreign       Show only foreign packages"
  echo "  -o, --orphans       Show only orphan packages"
  echo "  -e, --explicit      Show only explicitly installed packages"
  echo "  -d, --deps          Show only dependency packages"
  echo "  -n, --notadep       Not a dependency for anything"
  echo "  -k, --notoptdep     Not an optional dependency for anything"
  echo "  --has-note          Only packages that have a user note"
  echo "  --no-note           Only packages without a user note"
  echo "  -f, --field F V     Only packages where field F matches value V"
  echo "                      (repeatable, AND-combined; e.g. -f Name vim)"
  echo "  -a, --any V         Only packages where any field matches value V"
  echo "                      (repeatable, AND-combined with everything else)"
  echo "  -x, --exact-match   Use exact equality (instead of substring) for -f/-a"
  echo "  -v, --invert [F]    Bare -v inverts the entire result, applied last."
  echo "                      -v FILTER (repeatable) inverts only that one canned"
  echo "                      filter, leaving every other active filter untouched"
  echo "                      (e.g. -e -v notadep -v notoptdep = explicit packages"
  echo "                      where NOT(notadep AND notoptdep)). FILTER is one of:"
  echo "                      foreign/orphan/explicit/deps/notadep/notoptdep or"
  echo "                      their short letters m/o/e/d/n/k"
  echo ""
  echo "Sort Options:"
  echo "  -s, --sort-by [F]   Sort by field F (default field: Name; bare -s means"
  echo "                      Installed_Size; --size also still works)"
  echo "  --asc               Sort ascending (applies to whichever field is sorted)"
  echo "  --desc              Sort descending (applies to whichever field is sorted)"
  echo ""
  echo "Display Options:"
  echo "  --exact             Use exact matching in fzf (-e flag)"
  echo "  --hide-notes        Hide user notes in the preview pane"
  echo "  -t, --totalsize     Show total size of the (filtered) packages"
  echo ""
  echo "Notes:"
  echo "  -D <pkg> <note>     Set a note for a package"
  echo "  -D <pkg> -d         Delete the note for a package"
  echo "  --notes-list        List all packages that have notes"
  echo ""
  echo "Other:"
  echo "  -h, --help          Show this help message"
  echo "  -r, --refresh       Refresh the package database"
  echo ""
  echo "Inside the interactive picker:"
  echo "  ctrl-r              Rebuild the package cache and refresh the visible"
  echo "                      list, without leaving fzf - the header shows"
  echo "                      '✓ cache refreshed at HH:MM:SS' when done, so"
  echo "                      repeated presses are visibly distinct"
}

show_total() {
  GREEN=$'\033[32m'
  echo "selected package size:$GREEN"
  python "$SCRIPT_LIST" "${PYTHON_ARGS[@]}"
}

show_interactive() {
  # When --hide-notes is passed, forward it so previewItem skips the notes DB.
  local notes_flag=""
  if [[ "$SHOW_NOTES" == "false" ]]; then
    notes_flag=" --hide-notes"
  fi

  # The preview command is a single string that fzf runs through a shell, with
  # {} substituted (and shell-quoted) by fzf. We quote $SCRIPT_PREVIEW with
  # embedded double quotes so a $HOME containing spaces still works.
  local preview_cmd="printf '%s\n' {} | python \"$SCRIPT_PREVIEW\"$notes_flag"

  # Build a properly-quoted "python list_packages.py <args>" string for fzf's
  # reload() action. Every argument - including multi-word -f/-a values - needs
  # %q-style escaping; joining with plain spaces would split them again.
  local list_cmd
  printf -v list_cmd 'python %q' "$SCRIPT_LIST"
  local arg quoted
  for arg in "${PYTHON_ARGS[@]}"; do
    printf -v quoted '%q' "$arg"
    list_cmd="$list_cmd $quoted"
  done

  local create_db_cmd
  printf -v create_db_cmd 'python %q --quiet' "$SCRIPT_CREATE_DB"

  # Ctrl-R: rebuild the cache, refresh the visible list with the same filters,
  # then stamp the header with the time. transform-header needs a fairly recent
  # fzf. The \$(...) is escaped so *fzf's* shell evaluates it when the bind
  # fires, not pacfz's shell while building this string.
  local refresh_bind="ctrl-r:execute-silent($create_db_cmd)+reload($list_cmd)+transform-header(echo ✓ cache refreshed at \$(date +%H:%M:%S))"

  local fzf_opts=(
    --height=26
    --preview-window=right,70%
    --preview "$preview_cmd"
    --bind "$refresh_bind"
  )

  if [[ "$EXACT_MATCH" == "true" ]]; then
    fzf_opts+=(-e)
  fi

  echo "$package_list" \
  | fzf "${fzf_opts[@]}" \
  | python "$SCRIPT_PREVIEW"$notes_flag
}

create_database() {
  # don't spam the chat
  python "$SCRIPT_CREATE_DB" '--quiet'
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
EXACT_MATCH="false"
SHOW_NOTES="true"
SHOW_TOTAL="false"
PYTHON_ARGS=()

# First pass: detect bash-only flags regardless of position. -t/--totalsize
# is checked here too (not just via `case $1` below) because it can appear
# anywhere on the command line, e.g. `pacfz -e -t` — with only `$1` being
# inspected, that combination used to fall through to the interactive
# picker instead of printing the total, since -e (not -t) was in position 1.
for arg in "$@"; do
  case "$arg" in
    --exact)      EXACT_MATCH="true"  ;;
    --hide-notes) SHOW_NOTES="false"  ;;
    -t|--totalsize) SHOW_TOTAL="true" ;;
  esac
done

# Build the argument array forwarded to Python, stripping bash-only flags.
# An array (not a string) preserves values containing spaces. -t/--totalsize
# stays in PYTHON_ARGS (list_packages.py needs to see it to compute the
# FILTERED total) — only --exact/--hide-notes are bash-only and stripped.
for arg in "$@"; do
  if [[ "$arg" != "--exact" && "$arg" != "--hide-notes" ]]; then
    PYTHON_ARGS+=("$arg")
  fi
done

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
if [[ "$SHOW_TOTAL" == "true" ]]; then
  show_total
  exit 0
elif [[ $# -gt 0 ]]; then
  case $1 in
    -m|--foreign|-o|--orphans|-e|--explicit|-d|--deps|-s|--size|--sort-by|-n|--notadep|-k|--notoptdep|--asc|--desc|--has-note|--no-note|-f|--field|-a|--any|-x|--exact-match|-v|--invert)
      package_list=$(python "$SCRIPT_LIST" "${PYTHON_ARGS[@]}")
      show_interactive
      exit 0
      ;;
    -h|--help)
      show_usage
      exit 0
      ;;
    -r|--refresh)
      create_database
      exit 0
      ;;
    --exact)
      package_list=$(python "$SCRIPT_LIST" "${PYTHON_ARGS[@]}")
      show_interactive
      exit 0
      ;;
    --hide-notes)
      package_list=$(python "$SCRIPT_LIST" "${PYTHON_ARGS[@]}")
      show_interactive
      exit 0
      ;;
    -D)
      python "$SCRIPT_NOTES" "$@"
      exit 0
      ;;
    --notes-list)
      python "$SCRIPT_NOTES" --list
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      show_usage
      exit 1
      ;;
  esac
else
  # No arguments: show all packages
  package_list=$(python "$SCRIPT_LIST")
  show_interactive
  exit 0
fi
