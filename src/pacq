#!/usr/bin/env bash
# pacq - non-interactive query into the pacman package database.
# Forwards all flags straight to list_packages.py except -h/--help,
# which prints this script's own usage instead of argparse's.

# Find list_packages.py either next to this script (running straight from a
# git checkout) or under /usr/share/pacfz (installed via the PKGBUILD).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$SCRIPT_DIR/lib/list_packages.py" ]]; then
  PACFZ_LIBDIR="$SCRIPT_DIR/lib"
else
  PACFZ_LIBDIR="/usr/share/pacfz/lib"
fi
SCRIPT_LIST="$PACFZ_LIBDIR/list_packages.py"

show_usage() {
  echo "Usage: pacq [OPTIONS]"
  echo ""
  echo "Non-interactive package query (no fzf). All options are forwarded"
  echo "to list_packages.py."
  echo ""
  # Filter/Sort/Size flags are shared with pacfz, so their wording lives once
  # in list_packages.py and both wrappers just print it.
  python "$SCRIPT_LIST" --print-help
  echo ""
  echo "Other:"
  echo "  -h, --help          Show this help message"
  echo "  --version           Show the pacfz version"
}

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      show_usage
      exit 0
      ;;
  esac
done

exec python "$SCRIPT_LIST" --no-description "$@"
