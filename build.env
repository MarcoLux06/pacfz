# Sourceable shell snippet (NOT a full makepkg.conf - do not pass this to
# makepkg's --config, which fully replaces the system config rather than
# layering on top of it, and would silently drop compiler/compression/etc.
# defaults).
#
# Redirects every makepkg output path into ./build, relative to wherever
# you run makepkg from, so a build never touches the rest of the repo.
# BUILDDIR and PKGDEST are the two that matter for a plain `makepkg -si`
# (covering the extracted/staged trees and the final .pkg.tar.zst).
# SRCDEST/SRCPKGDEST/LOGDEST only kick in if you ever use a separate source
# cache, `--source`, or `--log` - included so the build stays fully
# contained even if the workflow grows to use those later.
#
# `make build`/`make install` source this automatically. To get the same
# behavior from a bare `makepkg -si` (no make), source it yourself first:
#
#   source build.env && makepkg -si
#
# This only takes effect for the shell session you source it into - it's
# not automatic the way a personal ~/.makepkg.conf override would be.
export BUILDDIR="$PWD/build"
export PKGDEST="$PWD/build"
export SRCDEST="$PWD/build"
export SRCPKGDEST="$PWD/build"
export LOGDEST="$PWD/build"
