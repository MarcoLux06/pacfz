# makepkg build artifacts — by default these would be "src/" and "pkg/" at
# the repo root, but Makefile/this project override BUILDDIR so makepkg
# never writes them here. This is just defensive, in case someone runs
# `makepkg` directly without going through `make build`/`make install`.
*.tar.*
*.log
.SRCINFO
/build/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv

# Editors
*.swp
.idea
pyproject.toml
uv.lock
